rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuarios - varios dispositivos precisam ler para logar no celular
    match /usuarios/{login} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Perfil - só dono
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Progresso - sync celular (qualquer anon pode salvar seu proprio uid)
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Conteúdo público somente leitura
    match /questoes/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /niveisQuiz/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /anatomiaCapitulos/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /relatorios/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
