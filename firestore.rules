rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{login} {
      allow read, write: if true;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /progress/{uid} {
      allow read, write: if true;
    }
    match /questoes/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /niveisQuiz/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /anatomiaCapitulos/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /relatorios/{docId} {
      allow create: if true;
      allow read: if true;
    }
  }
}

